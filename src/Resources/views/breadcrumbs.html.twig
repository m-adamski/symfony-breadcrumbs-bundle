<ol>

    {% if breadcrumbs|length > 0 %}
        {% set last_index = breadcrumbs|length - 1 %}
        {% set last_breadcrumb = breadcrumbs|last %}

        {% for breadcrumb in breadcrumbs|slice(0, last_index) %}
            <li>
                <a href="{% if breadcrumb.href is not null %}{{ breadcrumb.href }}{% else %}{{ path(breadcrumb.route, breadcrumb.routeParams) }}{% endif %}"
                    {% if breadcrumb.rel is not null %} rel="{{ breadcrumb.rel }}"{% endif %}
                    {% if breadcrumb.target is not null %} target="{{ breadcrumb.target }}"{% endif %}>
                    {{ breadcrumb.name }}
                </a>
            </li>
        {% endfor %}

        <li aria-current="page">
            {{ last_breadcrumb.name }}
        </li>
    {% endif %}

</ol>
