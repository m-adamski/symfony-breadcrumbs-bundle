{
    "name": "m-adamski/symfony-breadcrumbs-bundle",
    "description": "The Symfony Bundle, which simplifies the process of generating and displaying breadcrumbs",
    "type": "symfony-bundle",
    "license": "MIT",
    "authors": [
        {
            "name": "Maciej Adamski",
            "email": "m.adamski@ideacode.pl"
        }
    ],
    "require": {
        "php": ">=8.4",
        "symfony/framework-bundle": "^8.0",
        "symfony/twig-bundle": "^8.0"
    },
    "require-dev": {
        "kint-php/kint": "^6.1",
        "symfony/test-pack": "^v1.2"
    },
    "config": {
        "sort-packages": true
    },
    "autoload": {
        "psr-4": {
            "Adamski\\Symfony\\BreadcrumbsBundle\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Adamski\\Symfony\\BreadcrumbsBundleTests\\": "tests/"
        }
    },
    "extra": {
        "branch-alias": {
            "dev-master": "7.0.x-dev"
        }
    }
}
